KAFKA_BROKER=localhost:9092
SPARK_MASTER=local[*]
DATA_DIR=./data
LOG_DIR=./logs
MODEL_DIR=./models

# ── GCP / deployed system ────────────────────────────────────────────────────
GCP_PROJECT_ID=climate-prediction-system
GCP_REGION=us-central1
GCS_BUCKET=climate-prediction-system-data
BQ_DATASET=kenya_onset

# Cloud Run API URL printed by infrastructure/gcp/deploy_api.sh (M5).
# When set, the Streamlit dashboard loads Firestore / BigQuery /
# Vertex AI data via this endpoint. Leave blank to run in
# local-only / OpenMeteo-only mode.
API_URL=
API_TIMEOUT_S=5

# Vertex AI endpoint id printed by infrastructure/gcp/deploy_vertex.sh
# (M4). Optional - the API disables the ML layer cleanly when unset.
VERTEX_ENDPOINT_ID=
