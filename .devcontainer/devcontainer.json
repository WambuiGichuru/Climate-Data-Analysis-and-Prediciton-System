{
  "name": "Kenya Onset Advisory - Codespaces",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8000, 8501, 8080, 9092],
  "portsAttributes": {
    "8000": { "label": "FastAPI", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit Dashboard", "onAutoForward": "openBrowser" },
    "8080": { "label": "Kafka UI", "onAutoForward": "silent" },
    "9092": { "label": "Kafka broker", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1",
    "GCP_PROJECT_ID":   "sds2412-kenya-onset",
    "GCP_REGION":       "us-central1",
    "BQ_DATASET":       "kenya_onset",
    "GCS_BUCKET":       "sds2412-kenya-onset-data"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "googlecloudtools.cloudcode"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
